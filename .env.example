# Example environment variables for a migration validation run.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Values referenced as ${VAR} inside YAML config are resolved from the environment.

# --- Source database (Oracle) ---
SOURCE_HOST=oracle.example.com
SOURCE_PORT=1521
SOURCE_SERVICE=ORCLPDB1
SOURCE_USER=hr
SOURCE_PASSWORD=change-me

# --- Target database (Azure Database for PostgreSQL) ---
TARGET_HOST=my-pg.postgres.database.azure.com
TARGET_PORT=5432
TARGET_DATABASE=appdb
TARGET_USER=pgadmin
TARGET_PASSWORD=change-me

# Optional: override where JSON reports are written (defaults to ./reports).
# MV_REPORT_DIR=reports
# Optional: log level (DEBUG, INFO, WARNING, ERROR).
# MV_LOG_LEVEL=INFO
